ZABBIX_URL=https://zabbix.example.org/api_jsonrpc.php
ZABBIX_SERVER=zabbix.example.org
ZABBIX_PORT=10051
ZABBIX_TEMPLATE=Quanterra Q330 by collector
COLLECTOR_HOST=Monitoring Data Collector
# Optional comma-separated rollout filter, e.g. PUYO_QA,MORR_QA
COLLECTOR_HOST_FILTER=
COLLECTOR_INTERVAL=60
COLLECTOR_TIMEOUT=20
COLLECTOR_WORKERS=8
COLLECTOR_HEALTH_MAX_AGE=300
Q330_PORT=6381
# Compose injects ZABBIX_TOKEN_FILE using a mounted secret.
# For local execution export ZABBIX_TOKEN_FILE=/absolute/path/to/token
